+// along with the go-ethereum library. If not, see <http://www.gnu.org/licenses/>.
+
+package vm
+
+import (
+	"github.com/ethereum/go-ethereum/common"
+	"github.com/ethereum/go-ethereum/params"
+	"github.com/holiman/uint256"
+)
+
+// EngineMessage is a top-level (depth 0) message offered to an external
+// execution engine.
+type EngineMessage struct {
+	Create bool
+	Caller common.Address
+	To     common.Address // unused for Create
+	Input  []byte         // calldata or initcode
+	Gas    uint64
+	Value  *uint256.Int
+}
+
+// EngineResult is the outcome of a message executed by an external engine.
+// The engine has already applied its state changes to evm.StateDB.
+type EngineResult struct {
+	Ret     []byte
+	GasLeft uint64
+	Err     error
+	Created common.Address
+	// Failed reports a pre-execution failure (insufficient balance, depth,
+	// nonce overflow): no state was touched and all gas is returned.
+	Failed bool
+}
+
+// ExternalEngine executes top-level messages outside the Go interpreter, e.g.
+// the fastevm CPU/CUDA engine. Execute returns ok=false to let the built-in
+// interpreter run the message instead (unsupported fork, resource limits, ...).
+type ExternalEngine interface {
+	Execute(evm *EVM, msg *EngineMessage) (res EngineResult, ok bool)
+}
+
+// DefaultEngine, when set, is installed into every EVM whose Config.Engine is nil.
+var DefaultEngine ExternalEngine
+
+// Rules returns the chain rules the EVM was configured with.
+func (evm *EVM) Rules() params.Rules { return evm.chainRules }
+
+// Precompile returns the active precompiled contract at addr, if any.
+func (evm *EVM) Precompile(addr common.Address) (PrecompiledContract, bool) {
+	return evm.precompile(addr)
+}
+
+// PrecompileCache returns the precompile result cache in use, if any.
+func (evm *EVM) PrecompileCache() *PrecompileCache { return evm.precompileCache }
+
+func (evm *EVM) useEngine(caller common.Address) bool {
+	return evm.depth == 0 && evm.Config.Engine != nil && evm.Config.Tracer == nil && !isSystemCall(caller)
+}
+
+// engineGas converts an engine result into the budget form returned by
+// Call/Create.
+func engineGas(gas GasBudget, res *EngineResult) GasBudget {
+	if res.Failed {
+		return gas
+	}
+	used := gas.ExecutionGas - res.GasLeft
+	gas.ExecutionGas = res.GasLeft
+	gas.UsedExecutionGas += used
+	return gas.Exit(res.Err)
+}
