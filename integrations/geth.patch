+
+//go:build fastevm
+
+package tests
+
+import (
+	"fmt"
+	"os"
+	"testing"
+
+	"github.com/fastevm/fastevm/bindings/go/gethvm"
+)
+
+// With -tags fastevm every top-level message of the state and blockchain tests
+// runs on the fastevm engine (FASTEVM_BACKEND=cpu|gpu).
+func TestMain(m *testing.M) {
+	eng := gethvm.FromEnv()
+	gethvm.Install(eng)
+	code := m.Run()
+	fmt.Fprintf(os.Stderr, "fastevm: executed=%d fallbacks=%d skipped(fork)=%d fallback-errors=%v\n",
+		eng.Stats.Executed, eng.Stats.Fallbacks, eng.Stats.Skipped, eng.Stats.FallbackErrors)
+	os.Exit(code)
+}
