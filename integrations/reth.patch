@@ -431,11 +431,26 @@ impl EvmFactory for RethEvmFactory {
         #[cfg(feature = "jit")]
         self.configure_evm(evm);
 
-        #[cfg(not(feature = "jit"))]
+        // fastevm runs depth-0 frames when FASTEVM_BACKEND=cpu|gpu is set and takes precedence
+        // over the JIT runner; frames it hands back run on the evm2 interpreter.
+        #[cfg(feature = "fastevm")]
+        if let Some(runner) = fastevm_runner() {
+            evm.set_interpreter_runner(runner);
+        }
+
+        #[cfg(not(any(feature = "jit", feature = "fastevm")))]
         let _ = evm;
     }
 }
 
+/// The fastevm runner selected by `FASTEVM_BACKEND`, read once per process.
+#[cfg(feature = "fastevm")]
+fn fastevm_runner() -> Option<fastevm::runner::FastEvmRunner> {
+    static RUNNER: std::sync::OnceLock<Option<fastevm::runner::FastEvmRunner>> =
+        std::sync::OnceLock::new();
+    *RUNNER.get_or_init(fastevm::runner::FastEvmRunner::from_env)
+}
